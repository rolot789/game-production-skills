{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-spec.schema.json",
  "title": "specs/<asset-id>.yaml",
  "description": "Per-asset production contract emitted by game-asset-planner. Must carry enough deterministic truth for generation, normalization, QC, engine integration, runtime validation, and dependency-aware invalidation.",
  "type": "object",
  "required": [
    "schema_version",
    "asset_id",
    "category",
    "purpose",
    "source_versions",
    "style_authority",
    "production",
    "normalization",
    "runtime"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 3
    },
    "asset_id": {
      "$ref": "_defs.json#/$defs/id"
    },
    "family_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "type": "string",
      "enum": [
        "character",
        "environment",
        "interactive_object",
        "ui",
        "icon",
        "fx",
        "background"
      ]
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "priority": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "source_versions": {
      "type": "object",
      "description": "Upstream authority this spec was compiled from. Required: invalidation cannot run without it.",
      "required": [
        "game_spec",
        "art_style"
      ],
      "additionalProperties": true,
      "properties": {
        "game_spec": {
          "$ref": "_defs.json#/$defs/artifactRef"
        },
        "art_style": {
          "$ref": "_defs.json#/$defs/artifactRef"
        },
        "style_anchor_manifest": {
          "$ref": "_defs.json#/$defs/artifactRef"
        },
        "style_constraint_ledger": {
          "$ref": "_defs.json#/$defs/artifactRef"
        }
      }
    },
    "style_authority": {
      "type": "object",
      "required": [
        "anchor_ids",
        "constraint_ids",
        "category_overrides"
      ],
      "additionalProperties": false,
      "properties": {
        "anchor_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "constraint_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "category_overrides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "gameplay_meaning": {
          "type": [
            "string",
            "null"
          ]
        },
        "encoding_channels": {
          "type": "array",
          "description": "Channels that carry the state distinction. A gameplay-critical distinction needs at least one non-hue channel.",
          "items": {
            "type": "string",
            "enum": [
              "hue",
              "value",
              "shape",
              "icon",
              "motion",
              "position",
              "opacity"
            ]
          }
        }
      }
    },
    "orientation": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "family": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "canonical_parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "derivation_role": {
          "type": "string",
          "enum": [
            "canonical_parent",
            "derivative",
            "independent"
          ]
        },
        "shared_geometry_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "shared_anchor_group": {
          "type": [
            "string",
            "null"
          ]
        },
        "must_preserve": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_change": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "may_vary": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_introduce": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "animation": {
      "type": "object",
      "description": "One frame of an animation clip. A clip is an ordered family: each frame is its own asset sharing family_id, and this block carries the ordering the family model has no other way to express. Frames of one clip must share a canvas, a scale basis, and a runtime_pivot - a pivot that moves between frames is what jitter is.",
      "required": [
        "clip_id",
        "frame_index",
        "frame_count"
      ],
      "additionalProperties": true,
      "properties": {
        "clip_id": {
          "$ref": "_defs.json#/$defs/id"
        },
        "frame_index": {
          "type": "integer",
          "minimum": 0,
          "description": "0-based position in the clip."
        },
        "frame_count": {
          "type": "integer",
          "minimum": 2,
          "description": "Total frames in the clip. Every frame of one clip must agree."
        },
        "fps": {
          "type": "number",
          "minimum": 1,
          "description": "Playback rate. Readability is judged at this rate, not frame by frame."
        },
        "loop": {
          "type": "string",
          "enum": [
            "once",
            "loop",
            "pingpong"
          ],
          "description": "'loop' additionally requires the last frame to return to the first; 'once' does not, and loop closure is not checked for it."
        },
        "canonical_frame": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Index of the rest pose the other frames derive from. Identity drift is measured against this frame, not against the neighbour."
        },
        "hold_frames": {
          "type": [
            "integer",
            "null"
          ],
          "description": "How many playback frames this frame is held for, when the clip is not evenly timed."
        }
      }
    },
    "production": {
      "type": "object",
      "required": [
        "strategy",
        "derivation_mode"
      ],
      "additionalProperties": true,
      "properties": {
        "strategy": {
          "type": "string",
          "enum": [
            "generated_raster",
            "generated_vector",
            "generated_3d",
            "procedural",
            "runtime_primitive",
            "runtime_text",
            "shader_or_particle",
            "reuse_existing"
          ],
          "description": "How this asset is produced. Only `generated_raster` has a downstream production path in this toolkit; `runtime_primitive`, `runtime_text`, and `reuse_existing` author no file by design; `generated_vector`, `generated_3d`, `procedural`, and `shader_or_particle` are valid plans with no tooling behind them and cannot advance past READY_FOR_GENERATION. See toolkit-contract.yaml -> representation_strategies."
        },
        "derivation_mode": {
          "type": "string",
          "enum": [
            "independent",
            "parent_derived",
            "reference_edit",
            "procedural"
          ]
        },
        "strategy_rationale": {
          "type": "string"
        }
      }
    },
    "normalization": {
      "type": "object",
      "required": [
        "canvas_policy",
        "scale_policy",
        "anchor_policy",
        "pivot_policy"
      ],
      "additionalProperties": true,
      "properties": {
        "canvas_policy": {
          "type": [
            "string",
            "object"
          ]
        },
        "scale_policy": {
          "type": [
            "string",
            "object"
          ]
        },
        "anchor_policy": {
          "type": [
            "string",
            "object"
          ]
        },
        "pivot_policy": {
          "type": [
            "string",
            "object"
          ]
        },
        "target_canvas": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
            "width",
            "height"
          ]
        },
        "padding": {
          "type": "integer",
          "minimum": 0
        },
        "trim": {
          "type": "boolean"
        },
        "resample": {
          "type": "string",
          "enum": [
            "nearest",
            "bilinear",
            "bicubic",
            "lanczos"
          ]
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": [
        "footprint"
      ],
      "additionalProperties": true,
      "properties": {
        "footprint": {
          "type": [
            "string",
            "object"
          ]
        },
        "intended_display_size": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "width",
            "height"
          ],
          "properties": {
            "width": {
              "type": "integer",
              "minimum": 1
            },
            "height": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "background_policy": {
          "type": "string",
          "enum": [
            "transparent",
            "opaque",
            "runtime_composited"
          ],
          "default": "transparent",
          "description": "Omit for transparent. Game assets are cut out by default; state this field only to opt into an opaque or runtime-composited background."
        },
        "readability_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "state_readability_requirements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "backgrounds_encountered": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "gameplay_critical": {
          "type": "boolean"
        },
        "required_checks": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "qc_requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "upstream": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "downstream_hints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
