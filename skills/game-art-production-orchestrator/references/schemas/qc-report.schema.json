{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qc-report.schema.json",
  "title": "qc/<asset-id>/qc-report.yaml",
  "description": "Contract-verification result for one normalized asset. Bound to the exact normalized output_hash it evaluated.",
  "type": "object",
  "required": [
    "schema_version",
    "asset_id",
    "status",
    "evaluated",
    "technical",
    "findings"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "asset_id": { "$ref": "_defs.json#/$defs/id" },
    "family_id": { "type": ["string", "null"] },

    "status": {
      "type": "string",
      "enum": ["approved", "approved_with_minor_findings", "rework_required", "blocked"]
    },

    "evaluated": {
      "type": "object",
      "description": "Exactly which upstream versions this verdict applies to. A different output_hash means this verdict does not apply.",
      "required": ["normalized_output", "asset_spec"],
      "additionalProperties": true,
      "properties": {
        "normalized_output": { "$ref": "_defs.json#/$defs/artifactRef" },
        "asset_spec": { "$ref": "_defs.json#/$defs/artifactRef" },
        "generation_candidate": { "type": ["string", "null"] },
        "art_style": { "$ref": "_defs.json#/$defs/artifactRef" },
        "anchor_ids": { "type": "array", "items": { "type": "string" } },
        "constraint_ids": { "type": "array", "items": { "type": "string" } }
      }
    },

    "technical": {
      "type": "object",
      "description": "Deterministic checks. Produced by skills/game-asset-qc/scripts/technical_check.py, not by visual judgment.",
      "required": ["tool", "status", "checks"],
      "additionalProperties": true,
      "properties": {
        "tool": { "type": "string" },
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "checks": {
          "type": "object",
          "additionalProperties": { "$ref": "_defs.json#/$defs/verificationResult" }
        }
      }
    },

    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["anchor_id", "governed_dimensions", "result"],
        "additionalProperties": true,
        "properties": {
          "anchor_id": { "type": "string" },
          "role": { "type": "string" },
          "governed_dimensions": { "type": "array", "items": { "type": "string" } },
          "result": { "$ref": "_defs.json#/$defs/verificationResult" }
        }
      }
    },

    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["constraint_id", "type", "result"],
        "additionalProperties": true,
        "properties": {
          "constraint_id": { "type": "string" },
          "type": { "type": "string", "enum": ["HARD_FORBIDDEN", "SOFT_AVOID", "BOUNDED", "ANTI_REFERENCE"] },
          "result": { "$ref": "_defs.json#/$defs/verificationResult" },
          "evidence": { "type": "string" }
        }
      }
    },

    "accessibility": {
      "type": "array",
      "description": "Verification of the accessibility baseline declared in project.yaml. Required when the asset is gameplay critical.",
      "items": {
        "type": "object",
        "required": ["check_id", "result"],
        "additionalProperties": true,
        "properties": {
          "check_id": { "type": "string", "enum": ["A11Y_CONTRAST", "A11Y_COLOR_VISION", "A11Y_NON_COLOR_CHANNEL", "A11Y_RUNTIME_CONTRAST"] },
          "result": { "$ref": "_defs.json#/$defs/verificationResult" },
          "measured": { "type": ["string", "number", "null"] },
          "evidence": { "type": "string" }
        }
      }
    },

    "passing_dimensions": {
      "type": "array",
      "description": "Dimensions verified as correct. Carried into preserve_scope on any rework handoff.",
      "items": { "type": "string" }
    },

    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "dimension", "expected", "observed", "root_owner"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "severity": { "$ref": "_defs.json#/$defs/severity" },
          "dimension": { "type": "string" },
          "contract_source": { "type": "string" },
          "expected": { "type": "string" },
          "observed": { "type": "string" },
          "evidence": { "type": "string" },
          "reason_code": {
            "type": "string",
            "description": "Must resolve against contracts/routing.yaml symptom_classes[].id"
          },
          "root_owner": { "type": "string" },
          "required_action": { "type": "string" }
        }
      }
    },

    "rework_handoff": {
      "type": ["object", "null"],
      "description": "Present when status is rework_required or blocked. Validated against rework-handoff.schema.json."
    }
  }
}
