{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rework-handoff.schema.json",
  "title": "rework handoff envelope",
  "description": "Machine-checkable form of contracts/rework-handoff-contract.yaml. Every external specialist transition serializes to this shape.",
  "type": "object",
  "required": [
    "handoff_id",
    "from",
    "to",
    "subject",
    "root_owner",
    "reason_codes",
    "change_scope",
    "preserve_scope",
    "authoritative_inputs",
    "expected_outputs",
    "invalidation_scope",
    "revalidation_scope",
    "next_action"
  ],
  "additionalProperties": false,
  "properties": {
    "handoff_id": { "$ref": "_defs.json#/$defs/id" },
    "from": { "type": "string" },
    "to": { "type": "string" },
    "subject": {
      "type": "object",
      "required": ["type", "id"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["asset", "family", "scene", "category", "project"] },
        "id": { "type": "string" }
      }
    },
    "root_owner": { "type": "string" },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" },
      "description": "Each must resolve against contracts/routing.yaml symptom_classes[].id"
    },
    "authoritative_inputs": {
      "type": "array",
      "items": { "$ref": "_defs.json#/$defs/artifactRef" }
    },
    "change_scope": { "$ref": "_defs.json#/$defs/changeScope" },
    "preserve_scope": { "$ref": "_defs.json#/$defs/preserveScope" },
    "expected_outputs": { "type": "array", "items": { "type": "string" } },
    "invalidation_scope": { "$ref": "_defs.json#/$defs/invalidationScope" },
    "revalidation_scope": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "next_action": { "type": "string", "minLength": 1 }
  }
}
