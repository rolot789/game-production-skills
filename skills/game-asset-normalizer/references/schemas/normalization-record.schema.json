{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "normalization-record.schema.json",
  "title": "normalized/<asset-id>/normalization-record.yaml",
  "description": "Binds a normalized runtime output to the exact candidate and spec it was produced from. Emitted by skills/game-asset-normalizer/scripts/normalize.py.",
  "type": "object",
  "required": [
    "schema_version",
    "asset_id",
    "input_candidate",
    "asset_spec",
    "normalization_policy",
    "operations",
    "output",
    "validation"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "asset_id": { "$ref": "_defs.json#/$defs/id" },

    "input_candidate": {
      "type": "object",
      "required": ["id", "path", "content_hash"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "path": { "type": "string" },
        "content_hash": { "$ref": "_defs.json#/$defs/contentHash" },
        "generation_job_version": { "$ref": "_defs.json#/$defs/version" },
        "generation_record": { "type": ["string", "null"] }
      }
    },

    "asset_spec": { "$ref": "_defs.json#/$defs/artifactRef" },

    "normalization_policy": {
      "type": "object",
      "required": ["id", "version"],
      "additionalProperties": true,
      "properties": {
        "id": { "type": "string" },
        "version": { "$ref": "_defs.json#/$defs/version" }
      }
    },

    "change_scope": { "$ref": "_defs.json#/$defs/changeScope" },
    "preserve_scope": { "$ref": "_defs.json#/$defs/preserveScope" },

    "operations": {
      "type": "array",
      "description": "Ordered mechanical operations actually applied. Nothing here may redraw, restyle, or invent content.",
      "items": {
        "type": "object",
        "required": ["op"],
        "additionalProperties": true,
        "properties": {
          "op": {
            "type": "string",
            "enum": ["inspect", "trim", "scale", "canvas", "family_align", "alpha_clean", "metadata", "export"]
          },
          "detail": { "type": ["string", "object", "null"] }
        }
      }
    },

    "family_lineage": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "family_id": { "type": ["string", "null"] },
        "canonical_parent": { "type": ["string", "null"] },
        "shared_canvas": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "height"],
          "properties": {
            "width": { "type": "integer", "minimum": 1 },
            "height": { "type": "integer", "minimum": 1 }
          }
        },
        "shared_scale_basis": { "type": ["number", "string", "null"] }
      }
    },

    "geometry": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "source_size": { "type": "array", "items": { "type": "integer" }, "minItems": 2, "maxItems": 2 },
        "alpha_bbox": { "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4 },
        "scale_factor": { "type": "number" },
        "visual_anchor": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "runtime_pivot": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "collision_origin": { "type": ["array", "null"], "items": { "type": "number" } }
      }
    },

    "output": {
      "type": "object",
      "required": ["path", "content_hash", "width", "height"],
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string" },
        "content_hash": { "$ref": "_defs.json#/$defs/contentHash" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "mode": { "type": "string" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    },

    "validation": {
      "type": "object",
      "required": ["status", "checks"],
      "additionalProperties": true,
      "properties": {
        "status": { "type": "string", "enum": ["pass", "fail"] },
        "checks": {
          "type": "object",
          "additionalProperties": { "$ref": "_defs.json#/$defs/verificationResult" }
        },
        "failures": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
