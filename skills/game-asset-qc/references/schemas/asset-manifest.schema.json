{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "asset-manifest.schema.json",
  "title": "asset-manifest.yaml",
  "description": "Index over planned assets and families. In the lite profile, per-asset spec fields are inlined here instead of living in specs/<asset-id>.yaml.",
  "type": "object",
  "required": ["schema_version", "source_versions", "assets"],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "profile": { "type": "string", "enum": ["lite", "full"] },
    "source_versions": {
      "type": "object",
      "required": ["game_spec", "art_style"],
      "additionalProperties": true,
      "properties": {
        "game_spec": { "$ref": "_defs.json#/$defs/artifactRef" },
        "art_style": { "$ref": "_defs.json#/$defs/artifactRef" }
      }
    },
    "families": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["canonical_asset", "members"],
        "additionalProperties": true,
        "properties": {
          "canonical_asset": { "type": "string" },
          "topology": {
            "type": "string",
            "enum": [
              "CANONICAL_PARENT_TO_STATES",
              "CANONICAL_PARENT_TO_DIRECTIONS",
              "PARENT_TO_ANIMATION",
              "STATE_TO_TRANSITION",
              "INDEPENDENT_BUT_SHARED_STYLE"
            ]
          },
          "members": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "preserve": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "assets": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["category", "priority", "strategy", "lifecycle"],
        "additionalProperties": true,
        "properties": {
          "spec_path": { "type": ["string", "null"], "description": "null in the lite profile, where the spec is inlined here." },
          "spec": { "type": ["object", "null"], "description": "Inlined AssetSpec body in the lite profile." },
          "family_id": { "type": ["string", "null"] },
          "category": { "type": "string" },
          "priority": { "type": "string", "enum": ["P0", "P1", "P2", "P3"] },
          "tier": { "type": "integer", "minimum": 0, "maximum": 5 },
          "strategy": { "type": "string" },
          "lifecycle": {
            "type": "string",
            "enum": [
              "PLANNED", "READY_FOR_GENERATION", "GENERATED", "NORMALIZED", "QC_APPROVED",
              "INTEGRATION_READY", "RUNTIME_APPROVED", "SHIPPABLE",
              "GENERATION_REWORK", "NORMALIZATION_BLOCKED", "QC_REWORK",
              "INTEGRATION_REWORK", "RUNTIME_REWORK", "INVALIDATED"
            ]
          },
          "canonical_parent": { "type": ["string", "null"] }
        }
      }
    }
  }
}
