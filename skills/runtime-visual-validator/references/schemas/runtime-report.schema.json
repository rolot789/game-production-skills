{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "runtime-report.schema.json",
  "title": "runtime-validation/<asset-id>/runtime-report.yaml",
  "description": "Result of validating a QC-approved asset inside executable rendered contexts.",
  "type": "object",
  "required": [
    "schema_version",
    "asset_id",
    "status",
    "integrated_lineage",
    "contexts",
    "findings",
    "untested"
  ],
  "additionalProperties": true,
  "properties": {
    "schema_version": { "type": "integer", "const": 3 },
    "asset_id": { "$ref": "_defs.json#/$defs/id" },

    "status": {
      "type": "string",
      "enum": [
        "runtime_approved",
        "runtime_approved_with_minor_findings",
        "runtime_rework_required",
        "runtime_blocked",
        "partial_validation_only"
      ]
    },

    "build": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "id": { "type": ["string", "null"] },
        "executable": {
          "type": "boolean",
          "description": "false forces status to partial_validation_only or runtime_blocked. Supplied captures are never runtime approval."
        }
      }
    },

    "integrated_lineage": {
      "type": "object",
      "description": "The exact asset lineage that was running in the build. Runtime approval attaches to this lineage only.",
      "required": ["normalized_output", "qc_report"],
      "additionalProperties": true,
      "properties": {
        "normalized_output": { "$ref": "_defs.json#/$defs/artifactRef" },
        "qc_report": { "$ref": "_defs.json#/$defs/artifactRef" },
        "integration_plan": { "type": ["object", "null"] }
      }
    },

    "contexts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "level", "result"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "scene": { "type": "string" },
          "viewport": { "type": "string" },
          "camera": { "type": "string" },
          "states": { "type": "array", "items": { "type": "string" } },
          "level": { "type": "integer", "minimum": 1, "maximum": 4 },
          "result": { "$ref": "_defs.json#/$defs/verificationResult" },
          "capture_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    },

    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "severity", "context_id", "dimension", "expected", "observed", "root_owner"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "severity": { "$ref": "_defs.json#/$defs/severity" },
          "context_id": { "type": "string" },
          "capture_ids": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Required for BLOCKER and MAJOR visual findings. A visual claim without rendered evidence is not a finding."
          },
          "dimension": { "type": "string" },
          "expected": { "type": "string" },
          "observed": { "type": "string" },
          "reason_code": { "type": "string" },
          "root_owner": { "type": "string" },
          "root_reason": { "type": "string" },
          "regression_class": {
            "type": "string",
            "enum": ["INTENTIONAL_CHANGE", "SEMANTIC_REGRESSION", "COSMETIC_DELTA", "BASELINE_STALE"]
          },
          "qc_escape": { "type": "boolean" },
          "missed_qc_dimension": { "type": ["string", "null"] },
          "required_action": { "type": "string" }
        }
      }
    },

    "untested": {
      "type": "array",
      "description": "Material contexts that were not exercised. An empty list asserts full required coverage.",
      "items": {
        "type": "object",
        "required": ["context", "reason", "risk"],
        "additionalProperties": true,
        "properties": {
          "context": { "type": "string" },
          "reason": { "type": "string" },
          "risk": { "type": "string", "enum": ["low", "medium", "high"] }
        }
      }
    },

    "rework_handoff": { "type": ["object", "null"] }
  }
}
